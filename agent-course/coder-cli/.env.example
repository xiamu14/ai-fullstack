OPENAI_BASE_URL=
OPENAI_API_KEY=
# Models and API protocols are defined in provider.jsonc.
# Required only for provider=anthropic.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# Required only for provider=openrouter, for either protocol.
# API base URL. The SDK appends the request endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
TAVILY_API_KEY=
LOGFIRE_TOKEN=
# GAIA dataset access, after accepting the Hugging Face dataset conditions
HF_TOKEN=

# Optional; defaults to ~/.config/coder-cli/mcp.json
# CODER_MCP_CONFIG=/absolute/path/to/mcp.json

# Optional; trusted user policy, never loaded from project files
# CODER_PERMISSION_CONFIG=/absolute/path/to/permissions.json
