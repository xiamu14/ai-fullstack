# Toad 原始 TUI 样式摘录；仅删除未使用组件的规则，声明值保持原样。
# 来源与许可证见 TOAD-NOTICE.md。
Note,MarkdownNote {    
    padding: 0 1 0 0;
    &.-error {
        border: heavy $error;
    }    
    &.-stop-reason {        
        border: wide $error 50%;        
        padding: 0 1;
        MarkdownH2 {           
            margin: 1 0 1 0;
        }
    }
}

Conversation {    
    Window {                      
        layout: stream;
        margin: 0;                
        scrollbar-size-vertical: 2;        
        padding: 0 1 0 1;       
        height: 1fr;                
        align: left bottom;   
    }

    height: 1fr;    
    layers: base prompt float;        

    Contents {        
        layout: stream;
        width: 1fr;
        overflow: hidden;         
        height: auto;  
        padding: 0 0 0 0;                         
    }    

    ContentsGrid {            
        grid-size: 2;
        grid-columns: 1 1fr;
        grid-rows: auto;
        height: auto;                
    }

    #cursor-container {            
        height: auto;
        width: 1;                    
        color: $foreground 7%;            
                

    }        

    AgentResponse {         
        min-height: 1;        
        padding: 0 0 0 0;       
        overflow-x: auto;
        scrollbar-size-horizontal: 0;
        layout: stream;
        & > MarkdownBlock:last-child {            
            margin-bottom: 0;
        }
    }

    ToolCall {    
        # margin: 0 0 0 0 !important;    
        margin: 0 0 0 1 !important;        
        
        width: 1fr;
        layout: stream;
        height: auto;        

        .icon {
            width: auto;
            margin-right: 1;
        }
        #tool-content {
            display: none;
        }
        &.-has-content #tool-content {            
            margin: 1 1 1 0;            


        }
        &.-expanded {
            #tool-content {
                display: block;                
            }
            ToolCallHeader {
                text-wrap: wrap;
                text-overflow: fold;
            }
        }
        
        ToolCallHeader {  
            color: $text-secondary;   
            pointer: pointer;       
            width: auto;
            max-width: 1fr;   
            margin: 0 1 0 0;    
            text-wrap: nowrap;
            text-overflow: ellipsis;
        }        
    }
    padding-left: 1;  

    Terminal {        
        width: 1fr;
        height: auto;
        padding: 0 1 0 0;
        margin: 1 0;
        overflow: scroll;
        scrollbar-size: 0 0;          
    }

    TerminalTool {
        height: auto;   
        border: panel $primary 50%;                  
        border-title-color: $text-primary;
        background: $primary 10%;        
        padding: 1 1 0 1;              
        border-title-style: bold;

        &.-success {            
            border: panel $success-muted;                  
            border-title-color: $text-success;
            background: $success 7%;        
            opacity: 90%;
            border-title-style: not bold;                                 
            &:light {
                border: panel $success 50%;                  
                border-title-color: auto 90%;
            }
        }

        &.-error {            
            border: panel $error-muted;                  
            border-title-color: $text-error;
            background: $error 7%;        
            opacity: 90%;
            border-title-style: not bold;                                 
            &:light {
                border: panel $error-muted;                  
                border-title-color: auto 90%;
            }
        }
                  
    }
         
    UserInput {        
        border-left: blank $secondary;
        background: $secondary 15%;
        padding: 1 1 1 0;   
        margin: 1 1 1 0; 
        Markdown {            
            padding:0 2 0 0;
        }
        Markdown > MarkdownBlock:last-child {
            margin-bottom: 0;
        }
        MarkdownFence {                           
            margin: 0 2 1 0;
        }
        #prompt {
            margin: 0 1 0 0;
            color: $text-secondary;
        }
    }

}
