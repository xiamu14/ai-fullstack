{
  "format_on_save": "on",
  "formatter": {
    "language_server": {
      "name": "biome"
    }
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    }
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["vtsls", "biome", "..."]
    },
    "TSX": {
      "language_servers": ["vtsls", "biome", "..."]
    },
    "JavaScript": {
      "language_servers": ["vtsls", "biome", "..."]
    },
    "JSON": {
      "language_servers": ["biome", "..."]
    },
    "JSONC": {
      "language_servers": ["biome", "..."]
    },
    "CSS": {
      "language_servers": ["biome", "..."]
    }
  }
}
