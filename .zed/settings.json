{
  "format_on_save": "on",
  "formatter": "prettier",
  "prettier": {
    "allowed": true,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "formatter": "prettier",
      "language_servers": ["vtsls", "oxc", "..."]
    },
    "TSX": {
      "format_on_save": "on",
      "formatter": "prettier",
      "language_servers": ["vtsls", "oxc", "..."]
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": "prettier",
      "language_servers": ["vtsls", "oxc", "..."]
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": "prettier"
    }
  }
}
