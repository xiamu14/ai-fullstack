{
  "name": "interview-library",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3006",
    "build": "vite build",
    "check": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "bun scripts/migrate.ts",
    "import": "bun scripts/import.ts",
    "evaluate": "bun scripts/evaluate.ts",
    "backup": "docker compose exec -T postgres pg_dump -U interview -d interview --clean --if-exists",
    "restore": "docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U interview -d interview",
    "collect": "bun scripts/collection/collect.mjs",
    "read:notes": "bun scripts/collection/read-notes.mjs",
    "read:images": "python3 scripts/collection/read-images.py",
    "start": "bun scripts/serve.ts",
    "library:add": "bun scripts/library.ts",
    "export:md": "bun scripts/export-markdown.ts",
    "sources:review": "bun scripts/source-migration/review.ts",
    "sources:import": "bun scripts/source-migration/import.ts",
    "sources:verify": "bun scripts/source-migration/verify.ts",
    "sources:backup-check": "bun scripts/source-migration/backup-verification.ts",
    "sources:cleanup": "bun scripts/source-migration/cleanup.ts",
    "questions:evaluate": "bun scripts/question-expansion/evaluate.ts",
    "questions:evaluate:batches": "bun scripts/question-expansion/evaluate-batches.ts",
    "questions:verify:coverage": "bun scripts/question-expansion/verify-coverage.ts"
  },
  "dependencies": {
    "@remixicon/react": "latest",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "motion": "latest",
    "postgres": "latest",
    "react": "^19.2.0",
    "react-aria-components": "latest",
    "react-dom": "^19.2.0",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@tailwindcss/vite": "latest",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "packageManager": "bun@1.3.14"
}
