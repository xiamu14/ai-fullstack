# Application (Node.js runtime; Bun loads this file for package scripts)
PORT=3020
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/backend

# Compose uses the existing local postgres:17-alpine image, without pulling.
POSTGRES_PORT=5432
POSTGRES_DB=backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Required: generate a private random secret, e.g. openssl rand -base64 32
BETTER_AUTH_SECRET=
# Backend origin only; the native authentication path is /rpc/v1/auth.
BETTER_AUTH_URL=http://localhost:3020
# Comma-separated browser origins; BETTER_AUTH_URL is also trusted.
TRUSTED_ORIGINS=http://localhost:5173

# Optional: configure both values to enable Google OAuth.
# Authorized redirect URI: http://localhost:3020/rpc/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for email OTP and password account email verification.
# SMTP_SECURE=true for implicit TLS (usually port 465); false for STARTTLS (usually 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Backend <no-reply@example.com>"
